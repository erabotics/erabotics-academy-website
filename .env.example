# ERABOTICS backend — environment variables
#
# Copy this file to `.env` for local development (`.env` is git-ignored and must
# never be committed). In production, set the same names in Vercel:
# Project → Settings → Environment Variables. Never put real values in this file.

# ---- Database -------------------------------------------------------------
# Production: the Postgres connection string created by the Vercel ↔ Neon
# integration (Vercel adds DATABASE_URL / POSTGRES_URL automatically).
# Local development: a SQLite file inside the git-ignored .data/ folder.
DATABASE_URL=sqlite:///.data/local.db

# ---- Admin sign-in ---------------------------------------------------------
# The password itself is never stored. Generate the hash with:
#   python scripts/make_admin_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Long random secret (used to hash visitor IPs for rate limiting). Generate with:
#   python scripts/make_admin_hash.py --secret
SESSION_SECRET=

# ---- Session time ----------------------------------------------------------
# Signed out after this many minutes without activity …
SESSION_IDLE_MINUTES=30
# … and always after this many hours, even if active.
SESSION_MAX_HOURS=8

# ---- Optional forwarding ---------------------------------------------------
# Email notifications for orders, messages and applications (Formspree form URL).
FORMSPREE_ENDPOINT=
# Contact messages copied to the Google Sheet (Apps Script web-app URL).
SHEET_WEBHOOK_URL=

# Extra origins allowed to call the API (comma-separated). The site's own
# domain is always allowed; leave empty unless you add another domain.
ALLOWED_ORIGINS=
